# Twilio credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio phone number you bought or were assigned
TWILIO_PHONE_NUMBER=+15551234567

# Your personal phone number for testing
TEST_PHONE_NUMBER=+15557654321

# Caregiver alert test number
CAREGIVER_TEST_PHONE_NUMBER=+1916XXXXXXX

# Public HTTPS URL that points to your local FastAPI app
# Example from ngrok:
# PUBLIC_BASE_URL=https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://your-public-url.com

# App settings
APP_NAME=Senior Heat Voice Lab
APP_ENV=development

# AI models
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite:///./data/senior_heat_voice_lab.db

# Local scheduler worker
SCHEDULER_POLL_SECONDS=60

# HeatRisk provider
# Options: manual, nws
HEAT_RISK_PROVIDER=manual

# Used only when HEAT_RISK_PROVIDER=manual
# 0 = little/no risk, 1 = minor, 2 = moderate, 3 = major, 4 = extreme
MANUAL_HEAT_RISK_VALUE=2

# NWS/NOAA requests should identify the app
NWS_USER_AGENT=SeniorHeatVoiceLab/0.1 local-dev

# Dashboard auth
DASHBOARD_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-dev