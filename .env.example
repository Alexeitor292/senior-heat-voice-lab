# Twilio credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio phone number you bought or were assigned
TWILIO_PHONE_NUMBER=+15551234567

# Your personal phone number for testing
TEST_PHONE_NUMBER=+15557654321

# Public HTTPS URL that points to your local FastAPI app
# Example from ngrok:
# PUBLIC_BASE_URL=https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://your-public-url.com

# App settings
APP_NAME=Senior Heat Voice Lab
APP_ENV=development